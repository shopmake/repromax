# Copy to .env and fill in. On Render you can instead set these in Dashboard -> Environment
# (real environment variables always win over this file). Never commit .env.

# ---------- Core ----------
STORE_NAME=
ADMIN_SECRET=
EMPLOYEE_SECRET=
# Allowed website origins (comma-separated), e.g. https://yourstore.com,https://www.yourstore.com
FRONTEND_ORIGINS=
# Service-account JSON on ONE line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Cloudflare Turnstile SECRET key (must match the SITE key used on the website)
TURNSTILE_SECRET_KEY=

# ---------- Reseller ----------
RESELLER_API_KEY=
RESELLER_MASTER_KEY=
RESELLER_ENDPOINT=https://repromax5.onrender.com/api/reseller/v1

# ---------- Forgot password (Brevo email OTP) ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# (OTPs are hashed with ADMIN_SECRET — no separate secret needed)

# ---------- FF Glory Bot (Basic groups only) ----------
GLORY_API_KEY=
GLORY_MASTER_KEY=
GLORY_BASE_URL=https://ffglory.pro
GLORY_PRICE_BASIC_NRP=250
GLORY_MAX_GROUPS_PER_USER=5

# ---------- Optional ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_1=
TELEGRAM_CHAT_ID_2=
TELEGRAM_BALANCE_BOT_TOKEN=
TELEGRAM_LOAD_BOT_TOKEN=
TELEGRAM_LOAD_CHAT_ID=
IMGBB_API_KEY=
IMGBB_ENDPOINT=
CODE_PREFIX=
NOTIFY_ALL_REQUESTS=
